@startuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundcorner 6
skinparam shadowing false

skinparam sequence {
    ArrowColor #333333
    ArrowThickness 1.2
    ActorBorderColor #333333
    ActorBackgroundColor white
    LifeLineBorderColor #333333
    LifeLineBackgroundColor white
    ParticipantBorderColor #333333
    ParticipantBackgroundColor white
    ParticipantFontSize 12
    ParticipantFontStyle bold
}

skinparam note {
    BackgroundColor white
    BorderColor #DC2626
    FontColor #DC2626
    FontSize 11
}

title Диаграмма последовательности: Сценарий фиксации показателей дня (sd SaveHabitDay)

actor "Пользователь\n:User" as User
participant "view\n:TrackerView" as View
participant "presenter\n:HabitPresenter" as Presenter
participant "calc\n:DisciplineCalculator" as Calc
participant "streak\n:StreakManager" as Streak
participant "storage\n:JsonStorage" as Storage
participant "tray\n:SystemTrayService" as Tray

note over User, View
  <b>[lifeline]</b> Линия жизни объекта
end note

User -> View : onSaveClicked()
activate View
note right : <b>[synchronous message]</b>\nСинхронный вызов

View -> Presenter : onSaveRecord(recordData)
activate Presenter
note right : <b>[execution specification]</b>\nФокус управления (активация)

Presenter -> Calc : calculateDailyScore(record, settings)
activate Calc
Calc --> Presenter : score = 84.5%
note left : <b>[return message]</b>\nВозврат результата расчета
deactivate Calc

Presenter -> Streak : updateStreak(score)
activate Streak
Streak --> Presenter : streakInfo {count: 5, record: 12}
deactivate Streak

Presenter -> Storage : saveAtomic(record, streakInfo)
activate Storage

note over Storage : <b>[duration constraint]</b>\n{duration < 25ms} Ограничение длительности

ref over Storage
  <b>[interaction use (ref)]</b>
  <b>Фрейм Handle Atomic File Swap:</b>
  Запись habits_db.json.tmp -> fsync() -> fs::rename()
end ref

Storage --> Presenter : status = true
deactivate Storage

Presenter ->> Tray : showNotification("День закрыт: 84.5%! Стрик 5 дней")
activate Tray
note right : <b>[asynchronous message]</b>\nАсинхронный сигнал Qt Signal/Slot
deactivate Tray

Presenter --> View : updateDisplay(score, streakInfo)
deactivate Presenter

View --> User : Отображение зеленой ячейки и конфетти стрика
deactivate View
@enduml
