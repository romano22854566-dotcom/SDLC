@startuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam roundcorner 8
skinparam shadowing false

skinparam rectangle {
    BackgroundColor white
    BorderColor #4A3B69
    BorderThickness 1.2
    FontSize 14
    FontStyle bold
    FontColor #333333
}

skinparam usecase {
    BackgroundColor white
    BorderColor #4A3B69
    BorderThickness 1.2
    FontColor black
    FontSize 13
    ArrowColor #4A3B69
    ArrowThickness 1.1
}

skinparam actor {
    BorderColor #4A3B69
    FontColor black
    FontSize 13
}

left to right direction

actor "Пользователь" as User

rectangle "ИС «HabitFlow C++»" {
    usecase "Ввести показатели\nсна и питания" as UC_Data
    usecase "Учесть порцию\nводы (+250/+500 мл)" as UC_Water
    usecase "Настроить нормы\nпривычек" as UC_Settings
    usecase "Экспортировать историю\nв CSV" as UC_Export
    usecase "Просмотреть\nкалендарь" as UC_Calendar
    
    usecase "Рассчитать суточную\nдисциплину" as UC_Calc
    usecase "Анализировать серию\nдней (стрик)" as UC_Streak
    
    usecase "Сохранить запись\nв JSON" as UC_Save
    usecase "Подать звуковой сигнал\nотдыха (50/10)" as UC_Timer
}

actor "Системный таймер" as Timer

User -- UC_Data
User -- UC_Water
User -- UC_Calendar
User -- UC_Settings
User -- UC_Export

UC_Data ..> UC_Calc : <<include>>
UC_Water ..> UC_Calc : <<include>>
UC_Calc ..> UC_Save : <<include>>

UC_Calendar <.. UC_Streak : <<extend>>

UC_Save -[hidden]down-> UC_Timer

UC_Timer -- Timer
@enduml
