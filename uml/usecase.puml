@startuml
left to right direction
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam roundcorner 12
skinparam shadowing false
skinparam actorStyle awesome

skinparam rectangle {
    BackgroundColor #F8FAFC
    BorderColor #334155
    BorderThickness 1.5
    FontSize 13
    FontStyle bold
    FontColor #0F172A
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.2
    FontColor #1E293B
    FontSize 11
    ArrowColor #2563EB
    ArrowThickness 1.2
}

skinparam actor {
    BackgroundColor #DBEAFE
    BorderColor #1E40AF
    FontColor #0F172A
    FontSize 12
    FontStyle bold
}

skinparam note {
    BackgroundColor #FFFBEB
    BorderColor #F59E0B
    FontColor #78350F
    FontSize 9.5
}

actor "Пользователь\n(Студент / Пользователь)" as User
note left of User
  <b>Роль:</b> Основной пользователь,
  фиксирующий показатели сна,
  питания, воды и анализирующий
  интегральный процент дисциплины.
end note

actor "Системный таймер\n(Служба времени)" as Timer
note right of Timer
  <b>Роль:</b> Фоновый таймер (QTimer),
  отсчитывающий 50 минут работы
  и 10 минут перерыва (REQ-SYS-011).
end note

actor "Файловая система\n(ОС Windows / Linux)" as OS
note right of OS
  <b>Роль:</b> Операционная система,
  предоставляющая fsync() и замену
  временного файла .tmp для атомарности.
end note

rectangle "ИС «Десктопный трекер полезных привычек HabitFlow C++»" as System {
    usecase "UC-1: Ввести показатели\nсна и регулярности питания" as UC_SleepMeal
    usecase "UC-2: Учесть порцию\nвыпитой воды (+250/+500 мл)" as UC_Water
    usecase "UC-3: Рассчитать интегральный\nсуточный процент дисциплины" as UC_Calc #EFF6FF
    usecase "UC-4: Атомарно сохранить\nзапись в habits_db.json" as UC_Save #EFF6FF
    usecase "UC-5: Просмотреть интерактивный\nкалендарь дисциплины" as UC_Calendar
    usecase "UC-6: Анализировать серию\nдней и рекорд (стрик)" as UC_Streak
    usecase "UC-7: Настроить индивидуальные\nцелевые нормы привычек" as UC_Settings
    usecase "UC-8: Экспортировать историю\nдисциплины в CSV" as UC_Export
    usecase "UC-9: Подать фоновый звуковой\nсигнал отдыха (таймер 50/10)" as UC_Alert #FEF3C7
    usecase "UC-10: Свернуть в системный\nтрей / восстановить окно" as UC_Tray
}

' Ассоциации пользователя
User -- UC_SleepMeal
User -- UC_Water
User -- UC_Calendar
User -- UC_Settings
User -- UC_Export
User -- UC_Tray

' Отношения включения <<include>>
UC_SleepMeal ..> UC_Calc : <<include>>
UC_Water ..> UC_Calc : <<include>>
UC_Calc ..> UC_Save : <<include>>

' Отношения расширения <<extend>>
UC_Streak ..> UC_Calendar : <<extend>>
UC_Tray ..> UC_Alert : <<extend>>

' Ассоциации вспомогательных акторов
Timer -- UC_Alert
OS -- UC_Save
OS -- UC_Export

@enduml
