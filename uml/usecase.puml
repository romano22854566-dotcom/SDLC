@startuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam roundcorner 10
skinparam shadowing false
skinparam actorStyle awesome

skinparam rectangle {
    BackgroundColor #F8FAFC
    BorderColor #334155
    BorderThickness 1.5
    FontSize 16
    FontStyle bold
    FontColor #0F172A
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.4
    FontColor #1E293B
    FontSize 13.5
    ArrowColor #2563EB
    ArrowThickness 1.3
}

skinparam actor {
    BackgroundColor #DBEAFE
    BorderColor #1E40AF
    FontColor #0F172A
    FontSize 15
    FontStyle bold
}

left to right direction

actor "Пользователь\n(Студент / Пользователь)" as User
actor "Системный таймер\n(Служба времени)" as Timer
actor "Файловая система\n(ОС Windows / Linux)" as OS

rectangle "ИС «Десктопный трекер полезных привычек HabitFlow C++»" as System {
    usecase "UC-1: Ввести показатели\nсна и питания" as UC_SleepMeal
    usecase "UC-2: Учесть порцию воды\n(+250 / +500 мл)" as UC_Water
    usecase "UC-3: Рассчитать интегральную\nсуточную дисциплину" as UC_Calc #EFF6FF
    usecase "UC-4: Атомарно сохранить\nзапись в habits_db.json" as UC_Save #EFF6FF
    usecase "UC-5: Просмотреть интерактивный\nкалендарь дисциплины" as UC_Calendar
    usecase "UC-6: Анализировать серию\nдней и рекорд (стрик)" as UC_Streak
    usecase "UC-7: Настроить индивидуальные\nцелевые нормы привычек" as UC_Settings
    usecase "UC-8: Экспортировать историю\nдисциплины в CSV" as UC_Export
    usecase "UC-9: Подать фоновый звуковой\nсигнал отдыха (таймер 50/10)" as UC_Alert #FEF3C7
    usecase "UC-10: Свернуть в трей\n/ восстановить окно" as UC_Tray
}

User -- UC_SleepMeal
User -- UC_Water
User -- UC_Calendar
User -- UC_Settings
User -- UC_Export
User -- UC_Tray

UC_SleepMeal ..> UC_Calc : <<include>>
UC_Water ..> UC_Calc : <<include>>
UC_Calc ..> UC_Save : <<include>>

UC_Streak ..> UC_Calendar : <<extend>>
UC_Tray ..> UC_Alert : <<extend>>

Timer -- UC_Alert
OS -- UC_Save
OS -- UC_Export
@enduml
