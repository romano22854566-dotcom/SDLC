@startuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam shadowing false

skinparam activity {
    BackgroundColor white
    BorderColor #333333
    BorderThickness 1.2
    FontColor black
    FontSize 12
    ArrowColor #333333
    ArrowThickness 1.1
}

skinparam activityDiamond {
    BackgroundColor white
    BorderColor #333333
    FontColor black
    FontSize 11
}

title Диаграмма активности: Фиксация суточных привычек и расчет дисциплины

start

:Запуск сессии учета привычек;
:Ввод показателей (сон, вода, питание);

if (Данные корректны?) then (да)
    :Формирование сущности HabitRecord;
else (ошибка диапазонов)
    :Вывод предупреждения пользователю;
    stop
endif

:Расчет суточного процента дисциплины D\nпо взвешенной формуле 5 компонентов;

if (Процент дисциплины D >= 80%?) then (норма выполнена)
    :Инкремент счетчика серии (стрика);
    :Установка статуса «Успешный день» (Green);
else (срыв нормы)
    :Сброс текущей серии стрика в 0;
    :Установка статуса «Срыв режима» (Red/Yellow);
endif

:Сериализация обновленных данных в JSON;
:Запись во временный файл habits_db.json.tmp;
:Сброс дискового кэша ОС (fsync);

if (Запись успешна?) then (да)
    :Атомарное переименование fs::rename()\n(habits_db.json.tmp -> habits_db.json);
else (аппаратный сбой I/O)
    :Фиксация сбоя в лог habits_error.log;
    :Откат к резервной копии;
endif

:Обновление ячейки календаря и шкалы стрика;
:Отображение итоговой статистики в интерфейсе;

stop
@enduml
