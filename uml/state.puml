@startuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam shadowing false

skinparam state {
    BackgroundColor white
    BorderColor #333333
    BorderThickness 1.2
    FontColor black
    FontSize 12
    ArrowColor #333333
    ArrowThickness 1.1
}

title Диаграмма состояний: Жизненный цикл суточной записи привычек (HabitRecord)

[*] --> Draft : Наступление календарной даты

state "Черновик (Draft)" as Draft : Загрузка индивидуальных норм из настроек
Draft --> InProgress : onInputData() / Ввод сна, воды, питания

state "В процессе ввода (InProgress)" as InProgress : Заполнение параметров пользователем

InProgress --> Successful : [D >= 80%] / Инкремент стрика
InProgress --> Partial : [50% <= D < 80%] / Стрик сохранен
InProgress --> Failed : [D < 50%] / Обнуление стрика (0)

state "Успешный день (Successful)" as Successful : Статус GREEN в календаре
state "Частичный день (Partial)" as Partial : Статус YELLOW в календаре
state "Срыв режима (Failed)" as Failed : Статус RED в календаре

Successful --> Persisted : commit() / Атомарная запись в habits_db.json
Partial --> Persisted : commit() / Атомарная запись в habits_db.json
Failed --> Persisted : commit() / Атомарная запись в habits_db.json

state "Зафиксирована (Persisted)" as Persisted : Запись синхронизирована с диском

Persisted --> InProgress : onEditRecord() / Корректировка данных
Persisted --> Archived : onMidnight() / Смена календарной даты

state "Архивная (Archived)" as Archived : Доступна для чтения и экспорта в CSV

Archived --> [*]
@enduml
